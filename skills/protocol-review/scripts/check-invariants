#!/usr/bin/env bash
# Copyright (c) 2026 Daniel Joppi (https://github.com/swarm-routing)
# SPDX-License-Identifier: MIT OR GPL-2.0-only
#
# Thin wrapper: runs swarm-routing/.github tools/protocol-review/check_invariants.py from a
# cached snapshot of the org repo. All the logic is in check_invariants.py; this
# only finds it (org rule 9: the skill works because the script does).
#   ORG_TOOLS_DIR  use this checkout of swarm-routing/.github instead
#   ORG_TOOLS_REF  branch or tag to fetch (default main)
set -euo pipefail
# >>> cached-checkout (identical in every wrapper; tools/checks/check-plugins.py checks it)
# cached_checkout REPO REF [offline-ok]: print a directory holding swarm-routing/REPO at
# REF, as an immutable snapshot of the fetched commit. Each ref has its own cache dir,
# updated under a lock (flock, or where flock is missing a mkdir lock that
# records its pid, so a lock left by a killed run is taken over); a snapshot is
# extracted to a temporary dir and renamed into place, never changed afterwards, so an
# update by another session never changes the files under a running tool. Snapshots
# unused for 7 days are removed. With offline-ok, a failed fetch falls back to the
# snapshot this ref last used. SWARM_ROUTING_GIT replaces https://github.com/swarm-routing.
# Call it as dir=$(cached_checkout ...): the lock ends with that subshell.
cached_checkout() {
    local repo=$1 ref=$2 offline=${3:-} key cache rc pid
    # a ref of letters, digits, dots and hyphens is its own dir name; any other is
    # _ and its bytes in hex, so two refs never share a dir
    if printf '%s' "$ref" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9.-]*$'; then
        key=$ref
    else
        key=_$(printf '%s' "$ref" | od -An -tx1 | tr -d ' \n')
    fi
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/swarm-routing/checkouts/${repo#.}/$key
    mkdir -p "$cache" || return 1
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$cache/lock" || return 1
        if ! flock -w 600 9; then
            echo "cached_checkout: no lock on $cache in 600 s" >&2
            return 1
        fi
        cached_checkout_locked "$repo" "$ref" "$offline" "$cache"
        return
    fi
    for _ in $(seq 600); do
        if mkdir "$cache/lock.d" 2>/dev/null; then
            # this subshell's pid, so a waiter can tell a lock left by a killed run
            sh -c 'echo "$PPID"' >"$cache/lock.d/pid"
            trap 'rm -rf "$cache/lock.d"; exit 1' HUP INT TERM
            rc=0
            cached_checkout_locked "$repo" "$ref" "$offline" "$cache" || rc=$?
            rm -rf "$cache/lock.d"
            trap - HUP INT TERM
            return "$rc"
        fi
        pid=$(cat "$cache/lock.d/pid" 2>/dev/null) || pid=
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null &&
            [ "$(cat "$cache/lock.d/pid" 2>/dev/null)" = "$pid" ]; then
            echo "cached_checkout: removing the lock left by process $pid" >&2
            rm -rf "$cache/lock.d"
            continue
        fi
        sleep 1
    done
    echo "cached_checkout: no lock on $cache in 600 s" >&2
    return 1
}
cached_checkout_locked() {
    local repo=$1 ref=$2 offline=$3 cache=$4 url git sha tmp
    url=${SWARM_ROUTING_GIT:-https://github.com/swarm-routing}/$repo
    git=$cache/repo.git
    [ -d "$git" ] || git init -q --bare "$git" || return 1
    if git -C "$git" fetch -q --depth 1 "$url" "$ref" 2>"$cache/fetch.err"; then
        sha=$(git -C "$git" rev-parse 'FETCH_HEAD^{commit}') || return 1
    elif [ -n "$offline" ] && [ -s "$cache/current" ]; then
        sha=$(cat "$cache/current")
        echo "could not refresh $repo@$ref from $url; using the cached $sha" >&2
    else
        cat "$cache/fetch.err" >&2
        return 1
    fi
    if [ ! -d "$cache/$sha" ]; then
        tmp=$(mktemp -d "$cache/.tmp.XXXXXX") || return 1
        if ! git -C "$git" archive "$sha" | tar -x -C "$tmp"; then
            rm -rf "$tmp"
            return 1
        fi
        mv "$tmp" "$cache/$sha" || return 1
    fi
    printf '%s\n' "$sha" >"$cache/current"
    touch "$cache/$sha"
    find "$cache" -mindepth 1 -maxdepth 1 -type d -mtime +7 ! -name "$sha" ! -name repo.git \
        ! -name lock.d -exec rm -rf {} + 2>/dev/null || true
    printf '%s\n' "$cache/$sha"
}
# <<< cached-checkout
if [ -n "${ORG_TOOLS_DIR:-}" ]; then
    dir=$ORG_TOOLS_DIR
else
    dir=$(cached_checkout .github "${ORG_TOOLS_REF:-main}")
fi
exec python3 -I "$dir/tools/protocol-review/check_invariants.py" "$@"
