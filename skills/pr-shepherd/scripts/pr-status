# Thin wrapper: runs swarm-routing/.github tools/pr-status/pr_status.py from a
# cached shallow clone of the org repo. All the logic is in check_invariants.py; this
# only finds it (org rule 9: the skill works because the script does).
#   ORG_TOOLS_DIR  use this checkout of swarm-routing/.github instead
#   ORG_TOOLS_REF  branch or tag to fetch (default main)
set -euo pipefail
dir=${ORG_TOOLS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/swarm-routing/dotgithub}
ref=${ORG_TOOLS_REF:-main}
if [ -z "${ORG_TOOLS_DIR:-}" ]; then
    if [ -d "$dir/.git" ]; then
        git -C "$dir" fetch -q --depth 1 origin "$ref" && git -C "$dir" checkout -q --detach FETCH_HEAD
    else
        mkdir -p "$(dirname "$dir")"
        git clone -q --depth 1 --branch "$ref" https://github.com/swarm-routing/.github "$dir"
    fi
fi
exec python3 -I "$dir/tools/pr-status/pr_status.py" "$@"
