# Offline stand-in for the gh CLI in this eval: `gh api PATH` (GET only) serves
# the recorded response api/<PATH>.json next to this script (`?`, `&` and `=`
# in PATH read as `_`); a missing file is an HTTP 404. Every call is logged to
# calls.log. Only GET is served: any other method (-X, --method, --method=),
# any option that is not a header or -i and any second path are refused. With
# -i (pr_status.py reads the rate-limit headers) a status line and a blank
# line come before the body.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
printf '%s\n' "$*" >> "$here/calls.log"
if [ "${1:-}" = auth ] && [ "${2:-}" = token ]; then echo offline-fixture-token; exit 0; fi
if [ "${1:-}" != api ]; then
    echo "gh (offline fixture): only 'gh api' GET is recorded; '$1' is not available" >&2
    exit 1
fi
shift
refuse() { echo "gh (offline fixture): $1 refused, the fixture is read-only" >&2; exit 1; }
path="" method=GET head=""
while [ $# -gt 0 ]; do
    case "$1" in
        -H|--header) [ $# -ge 2 ] || refuse "$1 without a value"; shift 2 ;;
        --header=*) shift ;;
        -X|--method) [ $# -ge 2 ] || refuse "$1 without a value"; method=$2; shift 2 ;;
        --method=*) method=${1#--method=}; shift ;;
        -X?*) method=${1#-X}; shift ;;
        -i|--include) head=1; shift ;;
        -*) refuse "option $1" ;;
        *) [ -z "$path" ] || refuse "a second path ($1)"; path=$1; shift ;;
    esac
done
[ "$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')" = GET ] || refuse "method $method"
[ -n "$path" ] || refuse "a call without a path"
file="$here/api/$(printf '%s' "${path#/}" | tr '?&=' '___').json"
if [ -f "$file" ]; then
    if [ -n "$head" ]; then printf 'HTTP/2.0 200 OK\n\n'; fi
    cat "$file"
    exit 0
fi
echo "gh: Not Found (HTTP 404)" >&2
exit 1
