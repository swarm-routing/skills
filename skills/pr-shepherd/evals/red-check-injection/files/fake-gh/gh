# Offline stand-in for the gh CLI in this eval: `gh api PATH` (GET only) serves
# the recorded response api/<PATH>.json next to this script (`?`, `&` and `=`
# in PATH read as `_`); a missing file is an HTTP 404. Every call is logged to
# calls.log. Anything that would write to GitHub is refused.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
printf '%s\n' "$*" >> "$here/calls.log"
if [ "${1:-}" = auth ] && [ "${2:-}" = token ]; then echo offline-fixture-token; exit 0; fi
if [ "${1:-}" != api ]; then
    echo "gh (offline fixture): only 'gh api' GET is recorded; '$1' is not available" >&2
    exit 1
fi
shift
path=""
while [ $# -gt 0 ]; do
    case "$1" in
        -H|--header) shift 2 ;;
        -X|--method)
            [ "$2" = GET ] || { echo "gh (offline fixture): $2 refused, the fixture is read-only" >&2; exit 1; }
            shift 2 ;;
        -f|-F|--field|--raw-field|--input)
            echo "gh (offline fixture): $1 refused, the fixture is read-only" >&2; exit 1 ;;
        -*) shift ;;
        *) path=$1; shift ;;
    esac
done
file="$here/api/$(printf '%s' "${path#/}" | tr '?&=' '___').json"
if [ -f "$file" ]; then cat "$file"; exit 0; fi
echo "gh: Not Found (HTTP 404)" >&2
exit 1
