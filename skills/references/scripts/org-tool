#!/usr/bin/env bash
# Copyright (c) 2026 Daniel Joppi (https://github.com/swarm-routing)
# SPDX-License-Identifier: MIT OR GPL-2.0-only
#
# Thin wrapper: runs one of swarm-routing/.github's tools from a cached shallow
# clone of the org repo. All the logic is in the tool; this only finds it (org
# rule 9: the skill works because the scripts do).
#   org-tool fidelity|lit-search|zenodo|org-sync ARGS...
#   ORG_TOOLS_DIR  use this checkout of swarm-routing/.github instead
#   ORG_TOOLS_REF  branch or tag to fetch (default main)
set -euo pipefail
case "${1:-}" in
    fidelity) py=tools/fidelity/fidelity.py ;;
    lit-search) py=tools/lit-search/lit_search.py ;;
    zenodo) py=tools/zenodo/zenodo.py ;;
    org-sync) py=tools/org-sync/org_sync.py ;;
    *) echo "usage: org-tool fidelity|lit-search|zenodo|org-sync ARGS..." >&2; exit 2 ;;
esac
shift
dir=${ORG_TOOLS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/swarm-routing/dotgithub}
ref=${ORG_TOOLS_REF:-main}
if [ -z "${ORG_TOOLS_DIR:-}" ]; then
    if [ -d "$dir/.git" ]; then
        # two commands, so set -e stops on a failed fetch instead of running a stale ref
        git -C "$dir" fetch -q --depth 1 origin "$ref"
        git -C "$dir" checkout -q --detach FETCH_HEAD
    else
        mkdir -p "$(dirname "$dir")"
        git clone -q --depth 1 --branch "$ref" https://github.com/swarm-routing/.github "$dir"
    fi
fi
exec python3 -I "$dir/$py" "$@"
